# Reverse proxy for Unit Talk V2.
#
# Every hostname is injected via an env var at deploy time and is never written
# into this repository. Caddy handles TLS issuance and renewal automatically via
# Let's Encrypt. All upstream ports stay bound inside the Docker network only.
#
#   {$CADDY_DOMAIN}                  -> api:4000         (existing API)
#   {$UNIT_TALK_WEB_DOMAIN}          -> web:4200         (public website)
#   {$UNIT_TALK_SMART_FORM_DOMAIN}   -> smart-form:4400  (capper intake)
#   {$UNIT_TALK_COMMAND_CENTER_DOMAIN} -> command-center:4300 (operator console)
#
# Caddy fails to parse a site address that expands to an empty string, so an
# unconfigured hostname stops the edge rather than silently serving the wrong
# application on the wrong name.

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}

(json_log) {
    log {
        output stdout
        format json
    }
}

{$CADDY_DOMAIN} {
    reverse_proxy api:4000

    import security_headers

    # Health check passthrough (no auth required)
    @health path /health
    handle @health {
        reverse_proxy api:4000
    }

    import json_log
}

{$UNIT_TALK_WEB_DOMAIN} {
    reverse_proxy web:4200

    import security_headers
    import json_log
}

{$UNIT_TALK_SMART_FORM_DOMAIN} {
    reverse_proxy smart-form:4400

    # The intake surface is authenticated and must never be cached by an
    # intermediary or framed by a third party.
    import security_headers
    header {
        Cache-Control "no-store"
        Referrer-Policy "same-origin"
    }

    import json_log
}

# Operator console (apps/command-center).
#
# Routed only once a hostname is provisioned. Until then the deployment sets
# this to `http://command-center.invalid`: Caddy parses it, the `http://`
# scheme suppresses automatic HTTPS so no certificate is ever requested, and
# `.invalid` is reserved by RFC 2606 so no resolver can answer it. The
# container still runs on the internal network, so the console is deployed but
# unreachable rather than absent — and an empty site address, which is what an
# unset variable would produce, crash-loops the whole edge.
#
# Deliberately NOT in caddy's `depends_on`: a console that fails to start must
# not be able to take the API, the website and the intake form offline with it.
{$UNIT_TALK_COMMAND_CENTER_DOMAIN} {
    reverse_proxy command-center:4300

    # Operator data is never cacheable and the console must never be framed.
    import security_headers
    header {
        Cache-Control "no-store"
        Referrer-Policy "same-origin"
    }

    import json_log
}

# HTTP → HTTPS redirect handled automatically by Caddy
