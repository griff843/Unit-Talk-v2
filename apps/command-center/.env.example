# URL of the API service (used for write actions)
API_BASE_URL=http://localhost:4000
UNIT_TALK_CC_API_KEY=

# fail_closed | fail_open. Production and staging are ALWAYS fail-closed and
# ignore this value entirely; it only has an effect when NODE_ENV or
# UNIT_TALK_APP_ENV names a development or test runtime. Left unset, the
# Command Center requires authentication.
COMMAND_CENTER_AUTH_MODE=fail_closed
COMMAND_CENTER_AUTH_USERNAME=
COMMAND_CENTER_AUTH_PASSWORD=
COMMAND_CENTER_AUTH_TOKEN=
COMMAND_CENTER_OPERATOR_IDENTITY=command-center

# Fail-closed gate on the Supabase Management API path (UTV2-1802). The storage
# health page reads relation sizes, growth and database pressure through an
# account-scoped management token; that path is refused entirely unless this
# variable is exactly "true" (trimmed, case-insensitive). Every other value —
# including "1", "yes" and the variable being absent — keeps it shut, and a shut
# gate is reported as a policy refusal rather than as a missing credential.
# Left at false here deliberately: the template documents the variable without
# opening the gate.
UNIT_TALK_COMMAND_CENTER_MANAGEMENT_API_ENABLED=false
