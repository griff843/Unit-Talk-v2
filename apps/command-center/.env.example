# URL of the API service (used for write actions)
API_BASE_URL=http://localhost:4000
UNIT_TALK_CC_API_KEY=

# fail_closed | fail_open. Production and staging are ALWAYS fail-closed and
# ignore this value entirely; it only has an effect when NODE_ENV or
# UNIT_TALK_APP_ENV names a development or test runtime. Left unset, the
# Command Center requires authentication.
COMMAND_CENTER_AUTH_MODE=fail_closed
COMMAND_CENTER_AUTH_USERNAME=
COMMAND_CENTER_AUTH_PASSWORD=
COMMAND_CENTER_AUTH_TOKEN=
COMMAND_CENTER_OPERATOR_IDENTITY=command-center
