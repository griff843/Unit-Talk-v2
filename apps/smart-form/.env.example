GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=

# Approved cappers, comma-separated email addresses. This is the ONLY source of
# sign-in authority: there is no compiled-in allowlist, so leaving this empty
# means no account can sign in (fail closed). UTV2-1824: each entry MUST carry
# its canonical capper id explicitly as email=capperId. The id is never derived
# from the local part of the address, and an entry with no explicit mapping, or
# one whose id falls outside [a-z0-9][a-z0-9_-]*, is dropped and admits nobody.
#   ALLOWED_CAPPER_EMAILS=capper.one@example.com=capper-one,capper.two@example.com=capper-two
# Never commit a real personal address to this file — set it in the deployment
# environment.
ALLOWED_CAPPER_EMAILS=

# QA-only authentication bypass. Defaults OFF, is ignored entirely when
# NODE_ENV=production, and must be set explicitly to run the fixture E2E suite.
#
# The gate it controls lives in the client component `app/submit/page.tsx`, so
# the variable has to reach the browser bundle. Next.js only inlines names
# prefixed `NEXT_PUBLIC_`, which makes NEXT_PUBLIC_SMART_FORM_QA_AUTH_BYPASS the
# one that actually works: setting the unprefixed name alone leaves the bypass
# disabled and the fixture E2E suite redirects to /login.
#
# The unprefixed name is still read by `isQaAuthBypassEnabled` on the server
# side (route handlers, `auth.ts`), so both are listed. Set the NEXT_PUBLIC_ one
# for E2E.
NEXT_PUBLIC_SMART_FORM_QA_AUTH_BYPASS=
SMART_FORM_QA_AUTH_BYPASS=
