{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git * push * main)",
      "Bash(git * push * main *)",
      "Bash(git * push *:main)",
      "Bash(git * push *:main *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * --force*)",
      "Bash(sh -c *push*)",
      "Bash(bash -c *push*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api * DELETE*)",
      "Bash(supabase db reset *--linked*)",
      "Bash(supabase db reset *--db-url*)",
      "Bash(supabase migration repair*)",
      "Bash(supabase functions deploy*)",
      "Bash(supabase secrets set*)",
      "Bash(curl *kill-switch*)",
      "Bash(curl *retry-delivery*)",
      "Bash(wget *kill-switch*)",
      "Bash(wget *retry-delivery*)",
      "mcp__claude_ai_Supabase__deploy_edge_function",
      "mcp__claude_ai_Supabase__create_edge_function_secret",
      "mcp__claude_ai_Supabase__create_branch",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "mcp__claude_ai_Supabase__rebase_branch",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__restore_project"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__claude_ai_Supabase__delete_branch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/bash-safety-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-msg-linear-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-proof-validator.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tier-c-path-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/artifact-drift-check.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-test-group.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/linear-sync-reminder.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact-reinjector.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; cd \"$ROOT\" && npx tsx scripts/agent-notify/agent-stop-hook.ts'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; cd \"$ROOT\" && bash .claude/hooks/session-summary.sh'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; cd \"$ROOT\" && bash .claude/hooks/untracked-scripts-check.sh'"
          }
        ]
      }
    ]
  }
}
